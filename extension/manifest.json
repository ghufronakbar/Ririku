{
  "manifest_version": 3,
  "name": "Ririku — Chrome Bridge",
  "version": "0.3.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "__MSG_actionTitle__", "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["player-state.js"],
    "world": "MAIN",
    "run_at": "document_idle",
    "all_frames": false
  }, {
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
